{
  "name": "lintel-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:synthetic": "node scripts/synthetic-dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "prepare:browser-host": "node scripts/prepare-browser-host.mjs",
    "prepare:browser-extension": "node scripts/prepare-browser-extension.mjs",
    "build:desktop-resources": "npm run prepare:browser-host && npm run prepare:browser-extension && npm run build",
    "tauri": "tauri",
    "desktop:build": "tauri build --bundles app"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
